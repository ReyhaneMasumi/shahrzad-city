# Shahrzad Homepage - Environment Variables
# Copy to .env.local for local development

# Base URL for API calls (relative to the app)
NEXT_PUBLIC_API_BASE_URL=/api

# Canonical site URL for SEO (sitemap, og:image, etc.)
NEXT_PUBLIC_SITE_URL=https://web.shahrzadcity.ir

# Optional: Analytics / monitoring IDs
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=