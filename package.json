{
  "name": "shahrzad-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint && node scripts/check-no-persian.mjs",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,css,scss,json,yml}\" \"{src,scripts,tests}/**/*.md\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,css,scss,json,yml}\" \"{src,scripts,tests}/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "^1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^9",
    "eslint-plugin-playwright": "^2",
    "eslint-plugin-testing-library": "^7",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.34.6"
}
