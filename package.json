{
  "name": "shahrzad-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint && node scripts/check-no-persian.mjs",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,tsx}\" \"eslint.config.mjs\" \"next.config.ts\" \"prettier.config.mjs\" \"vitest.config.ts\" \"package.json\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,tsx}\" \"eslint.config.mjs\" \"next.config.ts\" \"prettier.config.mjs\" \"vitest.config.ts\" \"package.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "generate:icons": "node scripts/generate-pwa-assets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@serwist/turbopack": "^9.5.13",
    "antd": "^6.6.5",
    "axios": "1.20.0",
    "iconsax-react": "0.0.8",
    "msw": "2.11.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "10.0.0-preview.14",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "^1",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild-wasm": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-testing-library": "^7",
    "husky": "^9",
    "jsdom": "^30.1.2",
    "lint-staged": "^15",
    "png-to-ico": "^3.0.2",
    "prettier": "^3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.34.6",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
