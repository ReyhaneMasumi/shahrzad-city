{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "instructions": [
    "AGENTS.md",
    "docs/requirements/original-brief.md",
    "docs/architecture/10-docs-and-deprecations.md",
    "docs/architecture/11-agent-conventions.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "antd": {
      "type": "local",
      "command": ["npx", "-y", "@ant-design/cli", "mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--isolated"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--headless=true", "--isolated=true"],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      },
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git init*": "allow",
      "pnpm *": "allow",
      "node *": "allow",
      "docker build*": "allow",
      "docker run*": "allow",
      "docker compose*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf *": "deny"
    }
  },
  "agent": {
    "general": {
      "model": "opencode/big-pickle"
    },
    "reviewer": {
      "description": "Read-only reviewer. Checks a change against AGENTS.md and docs/architecture before commit.",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "prompt": "{file:./.opencode/prompts/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "pnpm lint*": "allow",
          "pnpm typecheck*": "allow"
        }
      }
    }
  }
}
